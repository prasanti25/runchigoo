DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_ENGINE=sqlite
# Recommended in production (Vercel Postgres/Neon/Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/database
MYSQL_DATABASE=ruchigo
MYSQL_USER=ruchigo
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_CONN_MAX_AGE=60
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
API_ANON_RATE=60/min
API_USER_RATE=300/min
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@ruchigo.local
EMAIL_TIMEOUT=10

# Server-side recommendations. Leave empty to use the catalog fallback.
# Never put these secrets in VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
IPINFO_TOKEN=
IPINFO_TRUSTED_PROXY_CIDRS=

# Optional GPS/map-pin address lookup. Server-side only; never use VITE_*.
# Provision a LocationIQ plan with appropriate production quota and restrictions.
LOCATIONIQ_API_KEY=
LOCATIONIQ_REGION=us1

# Enable online checkout only after configuring and testing the provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional isolated local preview database. Do not combine with DATABASE_URL.
# DJANGO_SQLITE_PATH=/private/tmp/ruchigo-product-preview.sqlite3
